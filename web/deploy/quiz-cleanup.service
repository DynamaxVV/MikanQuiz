[Unit]
Description=Clean expired unfinished quiz attempts
After=quiz-api.service

[Service]
Type=oneshot
User=quiz
Group=quiz
EnvironmentFile=/etc/quiz/quiz-api.env
ExecStart=/srv/quiz/venv/bin/python /srv/quiz/current/scripts/cleanup_expired_attempts.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/quiz/data
