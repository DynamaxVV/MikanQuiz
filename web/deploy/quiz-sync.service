[Unit]
Description=Publish MikanQuiz durable JSON sync outbox
After=network.target quiz-api.service

[Service]
Type=oneshot
User=quiz
Group=quiz
WorkingDirectory=/srv/quiz/current/backend
EnvironmentFile=/etc/quiz/quiz-api.env
ExecStart=/srv/quiz/venv/bin/python /srv/quiz/current/scripts/sync_worker.py --drain
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/quiz/data
