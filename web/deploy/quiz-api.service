[Unit]
Description=Quiz FastAPI service
After=network.target

[Service]
Type=simple
User=quiz
Group=quiz
WorkingDirectory=/srv/quiz/current/backend
# Keep key access logs in the persistent, service-writable data directory.
Environment=QUIZ_ACCESS_LOG_PATH=/srv/quiz/data/quiz-access.jsonl
EnvironmentFile=/etc/quiz/quiz-api.env
SyslogIdentifier=mikan-quiz-api
StandardOutput=journal
StandardError=journal
ExecStart=/srv/quiz/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/quiz/data

[Install]
WantedBy=multi-user.target
