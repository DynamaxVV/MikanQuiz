# Copy to .env.local. VITE_* values are PUBLIC and embedded during build.
# Leave the group name blank to hide the recruitment section.
VITE_SITE_GROUP_NAME=
VITE_SITE_GROUP_DESCRIPTION=
VITE_SITE_JOIN_GROUP=
VITE_SITE_CHAT_GROUP=

# Development server only. List explicit hostnames, separated by commas.
DEV_ALLOWED_HOSTS=
DEV_API_TARGET=http://127.0.0.1:8000
