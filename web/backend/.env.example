# Copy this file to .env and replace the placeholder values. Never commit .env.
QUIZ_DATABASE_URL=sqlite:///./var/quiz.db
QUIZ_ADMIN_SESSION_HOURS=8
QUIZ_COOKIE_SECURE=false
QUIZ_CONFIG_MAX_BYTES=10485760
# Optional additional HTTPS origins for imported font URLs, comma separated.
# QUIZ_FONT_SOURCE_ORIGINS=https://fonts.example.com

# Key request/audit events are written as rotating JSONL files.
QUIZ_ACCESS_LOG_PATH=./var/quiz-access.jsonl
QUIZ_ACCESS_LOG_MAX_BYTES=20971520
QUIZ_ACCESS_LOG_BACKUP_COUNT=14

# Use local files while debugging. The API serves these files at /uploads.
# QUIZ_STORAGE_BACKEND=local
# QUIZ_LOCAL_STORAGE_PATH=./var/uploads
# QUIZ_LOCAL_PUBLIC_BASE_URL=http://127.0.0.1:8000/uploads

QUIZ_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
QUIZ_R2_ACCESS_KEY_ID=replace-with-r2-access-key
QUIZ_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
QUIZ_R2_BUCKET=hanzipen-images
QUIZ_R2_PUBLIC_BASE_URL=https://images.example.com
