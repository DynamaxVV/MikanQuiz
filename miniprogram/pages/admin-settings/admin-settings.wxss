page { background: #fff9f0; color: #332718; }
.page { padding: 28rpx 26rpx 70rpx; }
.state { color: #9b856d; padding: 150rpx; text-align: center; }
.section { font-size: 34rpx; font-weight: 700; margin: 34rpx 6rpx 16rpx; }
.card { background: #fff; border: 1rpx solid #f3e5d3; border-radius: 22rpx; padding: 24rpx; }
.count { align-items: center; display: flex; font-size: 27rpx; }.count input { background: #fff5e8; border-radius: 10rpx; color: #c27819; margin: 0 10rpx 0 auto; padding: 8rpx; text-align: center; width: 80rpx; }
.mode { border-top: 1rpx solid #f0e4d6; margin-top: 18rpx; padding-top: 18rpx; }.weights { display: flex; gap: 8rpx; margin-top: 10rpx; }.weights view { background: #fff8ed; border-radius: 9rpx; flex: 1; font-size: 20rpx; padding: 7rpx; }.weights input { font-size: 22rpx; text-align: center; width: 100%; }
.help { color: #9b856d; font-size: 23rpx; line-height: 1.6; }.card textarea { font-size: 27rpx; line-height: 1.6; margin-top: 16rpx; min-height: 130rpx; width: 100%; }
.save { background: #c96d32; border-radius: 16rpx; color: #fff; font-size: 28rpx; margin-top: 26rpx; }.save:active { background: #ad5620; transform: scale(.98); }
.submission-group { border-bottom: 1rpx solid #f0e4d6; padding: 18rpx 0; }.submission-group:last-child { border-bottom: 0; }.group-title { align-items: center; color: #493522; display: flex; font-size: 27rpx; font-weight: 700; justify-content: space-between; }.group-title text:last-child { color: #9b856d; font-size: 22rpx; font-weight: 400; }
.submission { align-items: center; color: #705d49; display: flex; font-size: 24rpx; justify-content: space-between; padding: 14rpx 0 0; }.submission-score { color: #d4790b; font-size: 27rpx; font-weight: 700; }.fold { color: #b8731a; font-size: 23rpx; margin-top: 18rpx; }
.more { background:#fff0d8; border-radius:14rpx; color:#9f5c14; font-size:25rpx; margin-top:24rpx; }
.font-group { border-top:1rpx solid #f0e4d6; margin-top:14rpx; padding-top:14rpx; }.font-group-title { color:#493522; font-size:25rpx; font-weight:700; }.font-option { align-items:center; display:flex; gap:10rpx; margin-top:8rpx; }.font-option input { background:#fff8ed; border-radius:8rpx; flex:1; font-size:23rpx; padding:8rpx; }.font-option picker { border:1rpx solid #edcfac; border-radius:999rpx; color:#9f5c14; font-size:20rpx; padding:6rpx 12rpx; }.add-font { background:transparent; border:1rpx dashed #d7aa73; border-radius:12rpx; color:#9f5c14; font-size:22rpx; margin:12rpx 0 0; }
