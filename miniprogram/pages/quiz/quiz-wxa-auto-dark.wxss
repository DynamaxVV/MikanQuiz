@media (prefers-color-scheme: dark) {
    page {
        background: rgb(22, 23, 26);
    }

    .state {
        color: rgb(99, 106, 120);
    }

    .question-card, .result-card {
        background: rgb(17, 17, 17);
    }

    .question-number {
        color: rgb(128, 115, 249);
    }

    .question-text {
        color: rgb(217, 224, 243);
    }

    .option {
        background: rgb(22, 22, 25);
        color: rgb(172, 180, 195);
    }

    .option.selected {
        background: rgb(27, 27, 38);
        border-color: rgb(127, 113, 245);
        color: rgb(158, 137, 255);
    }

    .option.answer {
        background: rgb(16, 27, 20);
        border-color: rgb(0, 117, 50);
        color: rgb(60, 157, 94);
    }

    .option-key {
        background: rgb(32, 34, 39);
    }

    .selected .option-key {
        background: rgb(127, 113, 245);
        color: rgb(17, 17, 17);
    }

    .answer .option-key {
        background: rgb(0, 117, 50);
        color: rgb(17, 17, 17);
    }

    .submit, .retry {
        background: rgb(133, 118, 254);
        color: rgb(17, 17, 17);
    }

    .result-label, .result-summary {
        color: rgb(112, 119, 132);
    }

    .score {
        color: rgb(133, 118, 254);
    }

    .analysis {
        border-top: rgb(0, 0, 0);
        color: rgb(137, 145, 158);
    }

    .demo-tip {
        background: rgb(28, 22, 0);
        color: rgb(171, 134, 56);
    }
}
