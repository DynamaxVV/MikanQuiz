<view class="page"><view class="hint">正确字体从全局分区库选择；答题时将展示符合当前难度的所有分区。</view><view class="form-card"><textarea class="textarea" placeholder="题目文字" value="{{form.text}}" data-field="text" bindinput="updateField" auto-height maxlength="500" /><view class="difficulty-picker"><text>题目难度</text><view><text wx:for="{{[1,2,3]}}" wx:key="*this" data-value="{{item}}" bind:tap="selectDifficulty" class="star {{item <= form.difficulty ? 'active' : ''}}">★</text></view></view><view class="image-upload"><view class="option-label">题图</view><button class="upload-button" loading="{{uploadingImage}}" bind:tap="chooseImage">{{form.imageUrl ? '更换图片' : '上传图片'}}</button><view wx:if="{{form.imageUrl}}" class="image-preview"><image src="{{form.imageUrl}}" mode="aspectFill" /><text bind:tap="removeImage">移除图片</text></view></view><view class="option-label">正确字体</view><view wx:for="{{optionGroups}}" wx:key="id" class="preset-box"><view class="preset-title">{{item.name}}</view><view class="preset-list"><text wx:for="{{item.options}}" wx:for-item="option" wx:key="id" class="preset {{form.correctOptionId === option.id ? 'selected-preset' : ''}}" data-id="{{option.id}}" bind:tap="selectAnswer">{{option.name}} <text wx:if="{{option.minimumDifficulty > 1}}">{{option.minimumDifficulty}}★起</text></text></view></view><view class="analysis-title">题目解析</view><textarea class="textarea analysis-input" placeholder="填写所有用户都会看到的统一解析" value="{{form.explanation}}" data-field="explanation" bindinput="updateField" auto-height maxlength="1000" /><button class="save" loading="{{saving}}" bind:tap="saveQuestion">保存到题库</button></view></view>
