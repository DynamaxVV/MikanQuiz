@media (prefers-color-scheme: dark) {
    page {
        background: rgb(22, 23, 26);
    }

    .local-tip {
        background: rgb(19, 25, 32);
        color: rgb(105, 146, 192);
    }

    .section-title {
        color: rgb(206, 213, 234);
    }

    .form-card {
        background: rgb(17, 17, 17);
    }

    .textarea, .input-row {
        border-bottom: rgb(0, 0, 0);
    }

    .input-row text {
        color: rgb(133, 118, 254);
    }

    .image-button {
        background: rgb(27, 27, 38);
        color: rgb(150, 131, 255);
    }

    .answer-row {
        color: rgb(152, 161, 176);
    }

    .analysis-input {
        border-top: rgb(0, 0, 0);
    }

    .save {
        background: rgb(133, 118, 254);
        color: rgb(17, 17, 17);
    }

    .empty {
        color: rgb(90, 96, 108);
    }

    .question-row {
        background: rgb(17, 17, 17);
    }

    .question-name {
        color: rgb(194, 201, 217);
    }

    .delete {
        color: rgb(198, 66, 78);
    }
}
