page { background: #fff9f0; color: #332718; }
.page { padding: 42rpx 26rpx 72rpx; }
.state { color: #8f7c68; padding: 180rpx 52rpx; text-align: center; }
.eyebrow, .section-label { color: #c27717; font-size: 23rpx; font-weight: 700; letter-spacing: 2rpx; }
.title { font-size: 54rpx; font-weight: 700; letter-spacing: -2rpx; margin-top: 14rpx; }
.subtitle { color: #8c7761; font-size: 27rpx; margin: 14rpx 0 38rpx; }
.primary-card { align-items: center; background: #c96d32; border-radius: 28rpx; box-shadow: 0 18rpx 34rpx rgba(201, 109, 50, .22); color: #fff; display: flex; justify-content: space-between; padding: 38rpx 32rpx; }
.primary-card:active, .quick-card:active, .menu-card:active { transform: scale(.985); }
.primary-title { font-size: 38rpx; font-weight: 700; }.primary-desc { color: #ffe8d8; font-size: 25rpx; margin-top: 8rpx; }.primary-card text { font-size: 42rpx; }
.quick-row { margin-top: 18rpx; }.quick-card, .menu-card { align-items: center; background: #fff; border: 1rpx solid #f3e5d3; border-radius: 22rpx; box-shadow: 0 10rpx 24rpx rgba(116, 72, 20, .06); display: flex; padding: 26rpx; }
.quick-card { color: #493522; font-size: 30rpx; font-weight: 700; }.quick-card text { color: #9b856d; font-size: 23rpx; font-weight: 400; margin-top: 6rpx; }.quick-icon { align-items: center; background: #fff0d9; border-radius: 16rpx; color: #cf7500 !important; display: inline-flex; font-size: 40rpx !important; height: 74rpx; justify-content: center; margin: 0 18rpx 0 0 !important; width: 74rpx; }
.section-label { margin: 52rpx 6rpx 18rpx; }.menu-card { justify-content: space-between; }.menu-title { font-size: 30rpx; font-weight: 700; }.menu-desc { color: #9b856d; font-size: 23rpx; margin-top: 8rpx; }.arrow { color: #c77b23; font-size: 38rpx; }.logout { color: #a18a72; font-size: 26rpx; margin-top: 46rpx; text-align: center; }
