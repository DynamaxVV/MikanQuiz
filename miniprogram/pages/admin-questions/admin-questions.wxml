<view class="page">
  <view class="top"><view><view class="title">题库</view><view class="subtitle">点击题目可查看完整内容</view></view><button class="add" bind:tap="goAdd">＋ 新增</button></view>
  <view wx:if="{{loading}}" class="state">正在读取题库…</view>
  <view wx:elif="{{questions.length === 0}}" class="state">还没有题目，先添加第一道吧。</view>
  <block wx:else><view wx:for="{{questions}}" wx:key="_id" class="question-row" data-id="{{item._id}}" bind:tap="goDetail"><image wx:if="{{item.imageUrl}}" class="thumb" src="{{item.imageUrl}}" mode="aspectFill" /><view class="row-body"><view class="question-name">{{index + 1}}. {{item.text}}</view><view class="stars"><text wx:for="{{item.stars}}" wx:key="*this">★</text></view></view><text class="detail">查看</text><text class="delete" data-id="{{item._id}}" catchtap="deleteQuestion">删除</text></view><button wx:if="{{questions.length < total}}" class="more" loading="{{loadingMore}}" bind:tap="loadMore">加载更多题目</button></block>
</view>
