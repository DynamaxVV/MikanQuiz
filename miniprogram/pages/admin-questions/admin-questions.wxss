page { background: #fff9f0; color: #332718; }.page { padding: 28rpx 26rpx 70rpx; }.top { align-items: center; display: flex; justify-content: space-between; margin: 6rpx 2rpx 28rpx; }.title { font-size: 46rpx; font-weight: 700; }.subtitle { color: #9b856d; font-size: 24rpx; margin-top: 8rpx; }.add { background: #c96d32; border-radius: 14rpx; color: #fff; font-size: 25rpx; margin: 0; padding: 0 22rpx; }.add:active { background: #ad5620; transform: scale(.98); }.state { color: #a18a72; padding: 150rpx 0; text-align: center; }.question-row { align-items: center; background: #fff; border: 1rpx solid #f3e5d3; border-radius: 20rpx; box-shadow: 0 8rpx 22rpx rgba(116,72,20,.05); display: flex; margin-bottom: 14rpx; min-height: 106rpx; padding: 20rpx; }.question-row:active { transform: scale(.99); }.thumb { border-radius: 12rpx; height: 78rpx; margin-right: 16rpx; width: 78rpx; }.row-body { flex: 1; min-width: 0; }.question-name { color: #40301f; font-size: 27rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.stars { color: #ff9800; font-size: 22rpx; letter-spacing: 2rpx; margin-top: 8rpx; }.detail { color: #ba741e; font-size: 23rpx; margin-left: 16rpx; }.delete { color: #d75c54; font-size: 23rpx; margin-left: 16rpx; }.more { background:#fff0d8; border-radius:14rpx; color:#9f5c14; font-size:25rpx; margin-top:16rpx; }
