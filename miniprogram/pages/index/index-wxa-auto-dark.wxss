@media (prefers-color-scheme: dark) {
    page {
        background: rgb(22, 23, 26);
        color: rgb(223, 230, 246);
    }

    .eyebrow {
        color: rgb(133, 118, 254);
    }

    .title text {
        color: rgb(133, 118, 254);
    }

    .subtitle {
        color: rgb(116, 123, 137);
    }

    .card {
        background: rgb(17, 17, 17);
    }

    .primary {
        background: rgb(133, 118, 254);
        color: rgb(17, 17, 17);
    }

    .card-desc {
        color: rgb(99, 106, 120);
    }

    .primary .card-desc {
        color: rgba(17, 17, 17, 0.78);
    }

    .hint {
        color: rgb(92, 97, 111);
    }
}
