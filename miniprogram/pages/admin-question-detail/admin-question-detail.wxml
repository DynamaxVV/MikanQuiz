<view class="page"><view wx:if="{{loading}}" class="state">正在读取题目…</view><view wx:elif="{{!question}}" class="state">题目不存在或已删除。</view><view wx:else class="card"><view class="meta">题目详情 · <text wx:for="{{question.stars}}" wx:key="*this">★</text></view><view class="title">{{question.text}}</view><view wx:if="{{question.imageUrl}}" class="image-wrap" bind:tap="previewImage"><image class="image" src="{{question.imageUrl}}" mode="aspectFit" /><view class="zoom-tip">点击查看原图</view></view><view wx:if="{{question.configurationError}}" class="analysis"><view>题目待修复</view><text>{{question.configurationError}}</text></view><view wx:else class="option answer"><view>{{question.correctGroup.name}} · {{question.correctOption.name}}</view><view class="right">正确答案</view></view><view class="analysis"><view>题目解析</view><text>{{question.explanation || '该旧题目未填写统一解析。'}}</text></view><button class="edit-button" bind:tap="editQuestion">编辑题目</button></view></view>
