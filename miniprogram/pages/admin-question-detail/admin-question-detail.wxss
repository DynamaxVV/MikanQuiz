page { background:#fff9f0; color:#332718; }.page { padding:28rpx 26rpx 70rpx; }.state { color:#9b856d; padding:160rpx 0; text-align:center; }.card { background:#fff; border:1rpx solid #f3e5d3; border-radius:26rpx; box-shadow:0 12rpx 32rpx rgba(116,72,20,.07); padding:30rpx; }.meta { color:#c27819; font-size:24rpx; font-weight:700; }.meta text { color:#ff9800; letter-spacing:2rpx; }.title { font-size:35rpx; font-weight:700; line-height:1.55; margin:16rpx 0 26rpx; }.image-wrap { background:#fff8ed; border-radius:16rpx; margin-bottom:24rpx; overflow:hidden; padding:12rpx; position:relative; }.image { display:block; height:390rpx; width:100%; }.zoom-tip { background:rgba(51,39,24,.68); border-radius:999rpx; bottom:18rpx; color:#fff; font-size:21rpx; padding:8rpx 14rpx; position:absolute; right:18rpx; }.option { align-items:center; background:#fffaf4; border:2rpx solid transparent; border-radius:15rpx; display:flex; font-size:28rpx; margin-top:13rpx; min-height:82rpx; padding:0 18rpx; }.option text { color:#9c7243; font-weight:700; margin-right:18rpx; }.option.answer { background:#eff9ee; border-color:#58ad65; }.right { color:#39864a; font-size:22rpx; margin-left:auto; }.analysis { border-top:1rpx solid #f0e4d6; color:#705d49; font-size:26rpx; line-height:1.7; margin-top:28rpx; padding-top:22rpx; }.analysis view { color:#493522; font-weight:700; margin-bottom:8rpx; }
